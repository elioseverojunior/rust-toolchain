{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "PILOT - not wired into any task or CI. Scope is the modules dense with threshold and equality decisions. src/index.ts stays out: it is never imported and has no tests, so every mutant there would survive vacuously.",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test --config=stryker-bunfig.toml"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "src/action.ts",
    "src/cache/**/*.ts",
    "src/tools.ts",
    "!src/**/*.test.ts"
  ],
  "reporters": ["clear-text", "html", "progress"],
  "htmlReporter": {
    "fileName": ".stryker-tmp/mutation-report.html"
  },
  "clearTextReporter": {
    "maxTestsToLog": 0,
    "reportTests": false
  },
  "concurrency": 8,
  "timeoutMS": 60000,
  "tempDirName": ".stryker-tmp"
}
