{
  "name": "rust-toolchain",
  "module": "src/index.ts",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "description": "Rust Toolchain and Cache",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0,<25.0.0",
    "bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "private": true,
  "workspaces": {
    "packages": [
      "docs"
    ],
    "catalog": {
      "@types/bun": "^1.3.14",
      "@types/node": "^24.13.3",
      "mermaid": "^11.16.1",
      "typescript": "^6.0.3"
    }
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.11.6",
    "@stryker-mutator/core": "^10.0.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "action-docs": "^2.5.1",
    "eslint": "10.9.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.11.0",
    "mermaid": "catalog:",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build": "bun run build:action",
    "build:action": "bun build src/index.ts --outdir dist --target node --external none",
    "lint": "bun run eslint:lint && bun run prettier:format",
    "deps": "bunx --bun npm-check-updates -u --target minor && bun install",
    "deps:check": "bunx --bun npm-check-updates --target minor",
    "deps:latest": "bunx --bun npm-check-updates -u --target latest && bun install",
    "prettier:format": "prettier --check .",
    "prettier:format:fix": "prettier --write .",
    "eslint:lint": "eslint --max-warnings 0 .",
    "mermaid:lint": "bun scripts/lint-mermaid.ts",
    "eslint:lint:fix": "eslint --fix --max-warnings 0 .",
    "fix:all": "bun run eslint:lint:fix && bun run prettier:format:fix",
    "typecheck": "tsc --build",
    "typecheck:watch": "tsc --build --watch"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "smol-toml": "^1.8.0"
  }
}
