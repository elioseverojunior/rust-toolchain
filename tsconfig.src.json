{
  "extends": ["./tsconfig.base.json"],
  "compilerOptions": {
    // Build configs. `noEmit` is set in the base config — bun produces
    // dist/index.js — so these only scope what tsc will type-check. rootDir is
    // the repo root so tooling under scripts/ is checked alongside src/.
    "outDir": "./dist",
    "rootDir": ".",

    // Resolved relative to this file, so no `baseUrl` — it is deprecated as of
    // TypeScript 6.0 and errors with TS5101. The trailing `/*` on both sides is
    // what makes these prefix rules: without it `"@/"` matches only a module
    // named exactly `@/`, which resolves nothing and reports nothing.
    //
    // `@rust-toolchain` names the barrel, never `src/index.ts` — that file
    // exports nothing and calls `run()` at the top level, so importing it would
    // execute the action.
    "paths": {
      "@/*": ["./src/*"],
      "@rust-toolchain": ["./src/lib.ts"],
      "@rust-toolchain/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts"],
  // `docs/` is a self-managing subproject that needs `DOM` and React types
  // this project's type-check must not carry. It ships its own tsconfig.json,
  // which the root's solution-style tsconfig.json deliberately does NOT
  // reference — see the comment there for why, and `mise run docs:typecheck`
  // for what checks it instead.
  //
  // `dist` is belt-and-braces and changes the resolved file set not at all:
  // `include` matches only `.ts`, and TypeScript already excludes `outDir`
  // implicitly. Verified with `tsc --listFilesOnly`, identical either way.
  //
  // Keep it anyway. `tsconfig.base.json` sets `allowJs: true`, so the day
  // `include` grows a `.js` pattern, `dist/index.js` — 63k lines carrying a
  // vendored Azure SDK — lands in the action's type-check. This is the cheap
  // guard against that, not a statement that dist is being checked today.
  "exclude": ["node_modules", "docs", "dist"]
}
